    {
      "parameters": {
        "jsCode": "\nconst fs = require('fs');\nfunction scriptFor(t){ const title=String(t.title).slice(0,70); const hook=`This could change everything: ${title}.`; const script=`${hook} Here is the simple version. A new development is getting attention because it affects creators, developers, and everyday users. The key detail is not the headline, it is what happens next: faster tools, new risks, and a race to adapt. Watch this space, because the winners will be the people who understand it early.`; return {...t,title,hook,script,description:`${script} Subscribe for daily AI and tech Shorts.`,hashtags:['#AI','#Tech','#Shorts'],cta:'Follow for the next update.',visual_beats:['headline','problem','impact','future']}; }\nconst topics = items.map(i=>i.json.title?i.json:null).filter(Boolean);\nconst out = topics.map(scriptFor); fs.mkdirSync('output',{recursive:true}); fs.writeFileSync('output/scripts.json',JSON.stringify(out,null,2)); return out.map(json=>({json}));\n"
      },
