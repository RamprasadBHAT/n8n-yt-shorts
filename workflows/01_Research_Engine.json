    {
      "parameters": {
        "jsCode": "\nconst fs = require('fs');\nconst path = require('path');\nconst crypto = require('crypto');\nconst root = process.cwd();\nconst banned = fs.existsSync('11_Config/banned_topics.txt') ? fs.readFileSync('11_Config/banned_topics.txt','utf8').toLowerCase().split(/\\r?\\n/).filter(Boolean) : [];\nconst usedPath = path.join('state','used_topics.json');\nconst used = fs.existsSync(usedPath) ? JSON.parse(fs.readFileSync(usedPath,'utf8')) : [];\nconst seen = new Set(used.map(x => String(x.topic || '').toLowerCase()));\nfunction norm(t){return String(t||'').replace(/<[^>]+>/g,'').replace(/\\s+/g,' ').trim();}\nlet candidates=[];\nfor (const item of items) {\n  const body = item.json.body || item.json.data || item.json;\n  const text = typeof body === 'string' ? body : JSON.stringify(body);\n  const titles = [...text.matchAll(/<title><!\\[CDATA\\[(.*?)\\]\\]><\\/title>|<title>(.*?)<\\/title>|\"title\"\\s*:\\s*\"([^\"]+)\"/g)].map(m => norm(m[1]||m[2]||m[3]));\n  candidates.push(...titles);\n}\nconst fallback = fs.existsSync('11_Config/topics.txt') ? fs.readFileSync('11_Config/topics.txt','utf8').split(/\\r?\\n/).filter(Boolean).map(s => `${s} breakthrough creators should understand today`) : [];\ncandidates = candidates.length ? candidates : fallback;\nconst out=[];\nfor (const title of candidates) {\n  const lower=title.toLowerCase();\n  if (title.length < 12 || seen.has(lower) || banned.some(b => lower.includes(b))) continue;\n  if (out.some(x => x.title.toLowerCase() === lower)) continue;\n  out.push({id: crypto.createHash('sha256').update(lower).digest('hex').slice(0,16), title, angle:'Explain why this matters in under 40 seconds', keywords:title, source:'research-workflow'});\n  if (out.length === 10) break;\n}\nfs.mkdirSync('output',{recursive:true}); fs.writeFileSync('output/topics.json', JSON.stringify(out,null,2));\nreturn out.map(json => ({json}));\n"
      },
